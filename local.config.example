// Copy this file to local.config and fill in your own environment.
// local.config is gitignored — it will never be committed.
//
// Run with:
//   nextflow run main.nf -c local.config -profile conda --sample_info <path> --outdir <path>

params {
  seg               = "/path/to/segmentation_info_final.tsv"
  pp                = "/path/to/purity_ploidy_estimates.tsv"
  snp_path          = "/path/to/per_sample_snp_dir/"
  batch_info        = "/path/to/batch_info.tsv"  // also carries snv_vcf column; snv_pyclone is derived from path_to_trees/patient (SVclone)
  conversion_table  = "/path/to/sample_names.csv"

  // SVclone-specific inputs
  bam_dir           = "/path/to/bam_dir/"
  purple_dir        = "/path/to/purple_results/"
  coverage_info     = "/path/to/coverage_stats.csv"
  conversion_script = "/path/to/sample_name_version_converter.R"

  alpaca_env          = "/path/to/conda/envs/alpaca"           // conda env create -f alpaca_environment.yml
  svclone_env         = "/path/to/conda/envs/svclone-py36"     // conda env create -f svclone_environment.yml
  gurobi_home         = "/path/to/gurobi/linux64"
  gurobi_license_file = "/path/to/gurobi.lic"
  slurm_queue         = "general"
}
