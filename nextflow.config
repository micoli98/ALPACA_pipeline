params {
  // Required inputs — set these to your own data locations, e.g. via
  // -params-file or --seg/--pp/... on the command line.
  seg = null
  pp = null
  snp_path = null
  batch_info = null
  conversion_table = null
  sample_info = null
  pubDir = null

  // R helper scripts (shipped in this repo, resolved relative to the pipeline)
  harmonization_function = "${projectDir}/assets/1_harmonization_function.R"
  tree_conversion_functions = "${projectDir}/assets/2_tree_conversion_functions.R"
  ci_functions = "${projectDir}/assets/3_ci_functions.R"
  clones_comparison_functions = "${projectDir}/assets/5_clones_comparison_functions.R"

  // Environment — override for your own cluster
  conda_env = null
  gurobi_home = null
  gurobi_license_file = null
  slurm_queue = 'general'
}

// Environment-specific overrides (gitignored). Copy local.config.example to
// local.config and fill in your own values. Included here (rather than via
// -c on the command line) so params are resolved before env{}/process{}
// below reference them.
if (new File("${projectDir}/local.config").exists()) {
  includeConfig "${projectDir}/local.config"
}

env {
  GUROBI_HOME = params.gurobi_home
  GRB_LICENSE_FILE = params.gurobi_license_file
  LD_LIBRARY_PATH = "${System.getenv('LD_LIBRARY_PATH')}:${params.gurobi_home}/lib"
}

process {
  executor = 'slurm'
  queue = params.slurm_queue
  errorStrategy = 'ignore'
  withName: 'REFPHASE' {
    conda = params.conda_env
    memory = 8.GB
    cpus = 4
  }
  withName: 'ALPACA' {
    conda = params.conda_env
    cpus = 8
    memory = 16.GB
    maxRetries = 2
    maxForks = 2
  }
}

conda.enabled = true

executor {
  name = 'slurm'
  queueSize = 60
}
